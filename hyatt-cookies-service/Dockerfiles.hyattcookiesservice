FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

WORKDIR /app

# Install system dependencies for psycopg2 etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libglib2.0-0 libgobject-2.0-0 libnspr4 libnss3 libnss3-tools libdbus-1-3 \
    libatk1.0-0 libatk-bridge2.0-0 libexpat1 libatspi2.0-0 libx11-6 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libxcb1 libxkbcommon0 libasound2 \
 && rm -rf /var/lib/apt/lists/*


# Copy requirements file (adjust path if needed)
COPY ./hyatt-cookies-service/requirements.txt /app/requirements.txt

# Install python dependencies
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    playwright install chromium && \
    playwright install-deps chromium


# Copy application code
COPY ./hyatt-cookies-service /app

# Command to run hyatt cookies service and saves in redis server db=1
CMD ["python", "scheduler.py"]


